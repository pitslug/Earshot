root ::= "{" space "\"title\"" space ":" space text "," space "\"tldr\"" space ":" space text "," space "\"enhanced_notes\"" space ":" space root-enhanced-notes "," space "\"decisions\"" space ":" space root-decisions "," space "\"action_items\"" space ":" space root-action-items "," space "\"open_questions\"" space ":" space root-open-questions "," space "\"topics\"" space ":" space root-topics "}" space
ActionItem ::= "{" space "\"owner\"" space ":" space text "," space "\"task\"" space ":" space text "," space "\"due\"" space ":" space ( text | null ) "," space "\"source_segment_ids\"" space ":" space ActionItem-source-segment-ids "}" space
ActionItem-source-segment-ids ::= "[" space ActionItem-source-segment-ids-item ( "," space ActionItem-source-segment-ids-item ){0,2} "]" space
ActionItem-source-segment-ids-item ::= ( "1" | "2" | "3" | "4" | "5" ) space
Decision ::= "{" space "\"text\"" space ":" space text "," space "\"source_segment_ids\"" space ":" space Decision-source-segment-ids "}" space
Decision-source-segment-ids ::= "[" space Decision-source-segment-ids-item ( "," space Decision-source-segment-ids-item ){0,2} "]" space
Decision-source-segment-ids-item ::= ( "1" | "2" | "3" | "4" | "5" ) space
NoteBullet ::= "{" space "\"text\"" space ":" space text "," space "\"source_segment_ids\"" space ":" space NoteBullet-source-segment-ids "}" space
NoteBullet-source-segment-ids ::= "[" space ( NoteBullet-source-segment-ids-item ( "," space NoteBullet-source-segment-ids-item ){0,2} )? "]" space
NoteBullet-source-segment-ids-item ::= ( "1" | "2" | "3" | "4" | "5" ) space
NoteSection ::= "{" space "\"heading\"" space ":" space text "," space "\"bullets\"" space ":" space NoteSection-bullets "}" space
NoteSection-bullets ::= "[" space ( NoteBullet ( "," space NoteBullet ){0,11} )? "]" space
root-action-items ::= "[" space ( ActionItem ( "," space ActionItem ){0,11} )? "]" space
root-decisions ::= "[" space ( Decision ( "," space Decision ){0,11} )? "]" space
root-enhanced-notes ::= "[" space ( NoteSection ( "," space NoteSection ){0,11} )? "]" space
root-open-questions ::= "[" space ( text ( "," space text ){0,11} )? "]" space
root-topics ::= "[" space ( text ( "," space text ){0,11} )? "]" space
space ::= | " " | "\n" [ \t]{0,20}
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
text ::= "\"" [^"\\\x7F\x00-\x20] char* "\"" space
null ::= "null" space
----
root ::= "{" space "\"title\"" space ":" space text "," space "\"tldr\"" space ":" space text "," space "\"enhanced_notes\"" space ":" space root-enhanced-notes "," space "\"decisions\"" space ":" space root-decisions "," space "\"action_items\"" space ":" space root-action-items "," space "\"open_questions\"" space ":" space root-open-questions "," space "\"topics\"" space ":" space root-topics "}" space
