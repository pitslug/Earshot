ActionItem-source-segment-ids ::= "[" space "]" space
ActionItem-source-segment-ids-item ::= ( "1" ) space
Decision ::= "{" space "\"text\"" space ":" space text "," space "\"source_segment_ids\"" space ":" space Decision-source-segment-ids "}" space
Decision-source-segment-ids ::= "[" space "]" space
Decision-source-segment-ids-item ::= ( "1" ) space
NoteBullet ::= "{" space "\"text\"" space ":" space text "," space "\"source_segment_ids\"" space ":" space NoteBullet-source-segment-ids "}" space
NoteBullet-source-segment-ids ::= "[" space "]" space
NoteBullet-source-segment-ids-item ::= ( "1" ) space
NoteSection ::= "{" space "\"heading\"" space ":" space text "," space "\"bullets\"" space ":" space NoteSection-bullets "}" space
NoteSection-bullets ::= "[" space ( NoteBullet ( "," space NoteBullet ){0,11} )? "]" space
root-action-items ::= "[" space "]" space
root-decisions ::= "[" space "]" space
root-enhanced-notes ::= "[" space ( NoteSection ( "," space NoteSection ){0,11} )? "]" space
root-open-questions ::= "[" space ( text ( "," space text ){0,11} )? "]" space
root-topics ::= "[" space ( text ( "," space text ){0,11} )? "]" space
space ::= | " " | "\n" [ \t]{0,20}
char ::= [^"\\\x7F\x00-\x1F] | [\\] (["\\bfnrt] | "u" [0-9a-fA-F]{4})
text ::= "\"" [^"\\\x7F\x00-\x20] char* "\"" space
null ::= "null" space
