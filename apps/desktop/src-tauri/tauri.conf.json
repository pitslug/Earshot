{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot",
  "identifier": "io.github.pitslug.earshot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @earshot/desktop dev",
    "beforeBuildCommand": "pnpm --filter @earshot/desktop build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Earshot",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src blob:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "publisher": "Earshot",
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
