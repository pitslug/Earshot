{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Earshot",
  "identifier": "io.github.pitslug.earshot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "pnpm --filter @earshot/android dev",
    "beforeBuildCommand": "pnpm --filter @earshot/android build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Earshot"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "assetProtocol": {
        "enable": false
      }
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Earshot",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "android": {
      "minSdkVersion": 26
    }
  }
}