node_modules/
# Vite output and cache of the desktop app; Tauri's generated capability schemas
apps/desktop/dist/
.vite/
apps/desktop/src-tauri/gen/

# Fixtures: large sets are fetched outside the repo; private recordings never committed
fixtures/private/

# Models are fetched, never committed (keep the manifest)
/models/*
!/models/manifest.toml

# Audio and model weights (small committed smoke audio is the only exception)
*.wav
*.flac
!fixtures/smoke/**/*.wav
!fixtures/smoke/**/*.flac
# The benchmark meeting shipped with the app (T7.4c, cargo xtask bench-meeting)
!apps/desktop/src-tauri/resources/benchmark/*.flac
*.onnx
*.bin
*.gguf

